# Copy to .env.local and fill in. Never commit real values.

# ElevenLabs: agent lookup, signed URLs, pronunciation TTS (required)
ELEVENLABS_API_KEY=
# Optional: skip the lookup-by-name and use this agent directly
ELEVENLABS_AGENT_ID=

# Signs OTP tokens and session cookies (required in production). e.g. `openssl rand -hex 32`
APP_SECRET=

# Resend: sends OTP emails (optional in dev; without it the OTP is printed to the dev server console)
RESEND_API_KEY=
# Optional: sender address on a domain verified in Resend
RESEND_FROM=

# Optional: accept the fixed test code 12345 in production too. Leave unset in real deployments.
ALLOW_TEST_OTP=
